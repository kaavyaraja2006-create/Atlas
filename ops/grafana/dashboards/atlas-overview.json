{
  "uid": "atlas-overview",
  "title": "ATLAS overview",
  "tags": [
    "atlas"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by status",
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "atlas-prometheus"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{uri=~\"/api/v1/.*\"}[5m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 latency of API reads (NFR-PERF-1: < 300 ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "atlas-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{method=\"GET\", uri=~\"/api/v1/.*\", status=~\"2..\"}[5m])))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency by endpoint (top 10)",
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "atlas-prometheus"
          },
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri=~\"/api/v1/.*\"}[5m]))))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "5xx share of requests",
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "atlas-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count[5m])), 1e-9)",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Sign-ins by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "atlas-prometheus"
          },
          "expr": "sum by (outcome) (rate(atlas_auth_logins_total[5m])) * 60",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Rate-limit rejections by limit (per minute)",
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "atlas-prometheus"
          },
          "expr": "sum by (limit) (rate(atlas_ratelimit_rejected_total[5m])) * 60",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Recovery steps by outcome (last hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "atlas-prometheus"
          },
          "expr": "sum by (status) (increase(atlas_recovery_steps_total[1h]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Audit anchors taken / failed (last hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "atlas-prometheus"
          },
          "expr": "sum by (result) (increase(atlas_audit_anchors_total[1h]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Anchor verifications by result (last hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "atlas-prometheus"
          },
          "expr": "sum by (status) (increase(atlas_audit_anchor_verifications_total[1h]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Database connections (HikariCP)",
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "atlas-prometheus"
          },
          "expr": "sum by (state) (label_replace(hikaricp_connections_active, \"state\", \"active\", \"\", \"\") or label_replace(hikaricp_connections_idle, \"state\", \"idle\", \"\", \"\") or label_replace(hikaricp_connections_pending, \"state\", \"pending\", \"\", \"\"))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "JVM heap used",
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "atlas-prometheus"
          },
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "JVM GC pause time per second",
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "atlas-prometheus"
          },
          "expr": "sum(rate(jvm_gc_pause_seconds_sum[5m]))",
          "legendFormat": "__auto"
        }
      ]
    }
  ],
  "description": "Built on the metric names the backend exports (docs/security/hardening.md \u00a76). Not yet viewed against a running instance."
}
# Copy to .env (git-ignored) and choose your own local values.
ATLAS_DB_USER=atlas
ATLAS_DB_PASSWORD=change-me-locally
# Signs access tokens. Generate with: openssl rand -base64 48
ATLAS_JWT_SECRET=
# Set false only for plain-HTTP local development
ATLAS_COOKIE_SECURE=true
# Prometheus scrape credentials (the observability profile scrapes as user "prometheus";
# put the same password in ops/prometheus/metrics-password). At least 16 characters.
ATLAS_METRICS_USERNAME=prometheus
ATLAS_METRICS_PASSWORD=
# Grafana admin password for the observability profile
GRAFANA_ADMIN_PASSWORD=
# Local demo only: the seed makes ~1,000 API calls as one user and registers 4 users.
# Raise these for a local demo stack; leave them unset (600 / 5) anywhere real.
#ATLAS_RATELIMIT_APIPERMINUTE=100000
#ATLAS_RATELIMIT_REGISTRATIONSPERHOUR=50
